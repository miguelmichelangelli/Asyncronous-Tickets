ODOO_TIMEOUT_SECONDS=300
ODOO_MAX_RETRIES=2
ODOO_RETRY_BACKOFF_SECONDS=3

# Simulación de latencia en Odoo (para pruebas de estrés)
SIMULATE_ODOO_DELAY_SECONDS=0.0

# Cabeceras de autenticación parametrizables para Odoo
ODOO_HEADER_KEY_NAME=
ODOO_HEADER_KEY_VALUE=
ODOO_HEADER_TOKEN_NAME=
ODOO_HEADER_TOKEN_VALUE=

# Control de Concurrencia y Workers Asíncronos (Acordado: 5 workers)
WORKER_CONCURRENCY=5

# Conexión y Gestión de Redis Nativo
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=20
TASK_TTL_SECONDS=86400
IDEMPOTENCY_WINDOW_SECONDS=60

# Notificador Outbound (Artificialic / WhatsApp Meta)
MOCK_ARTIFICIALIC=True
ARTIFICIALIC_API_URL=https://api.artificialic.com/v1/messages
ARTIFICIALIC_API_TOKEN=mock_token
ARTIFICIALIC_TIMEOUT_SECONDS=15
NOTIFIER_MAX_RETRIES=3
NOTIFIER_RETRY_BACKOFF_SECONDS=2.0
SEND_FALLBACK_ON_ODOO_FAILURE=True

# Configuración del Servidor FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
